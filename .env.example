# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave empty to use SQLite in development)
DATABASE_URL=postgres://nawi:password@localhost:5432/nawi_db

# PostgreSQL (used by docker-compose.prod.yml)
POSTGRES_DB=nawi_db
POSTGRES_USER=nawi
POSTGRES_PASSWORD=change-me-to-a-secure-password

# Redis
REDIS_URL=redis://localhost:6379/0

# Reports
REPORT_STORAGE_PATH=/var/nawi/reports/

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS (comma-separated origins for production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SSL redirect (set to False behind a load balancer that terminates SSL)
SECURE_SSL_REDIRECT=True

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
